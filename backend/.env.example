# ==============================================================================
# TradeVision AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend/ directory to configure custom credentials.
# Note: TradeVision AI has built-in offline fallbacks and local mock providers;
# all services will run safely out-of-the-box even if third-party keys are blank.

# ------------------------------------------------------------------------------
# 1. AI Copilot (Groq Llama 3 / Qwen OSS Models)
# ------------------------------------------------------------------------------
# Get your free key at: https://console.groq.com/keys
# If left blank, TradeVision uses the local educational fallback engine.
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. Hugging Face Inference API
# ------------------------------------------------------------------------------
# Optional token for custom HF models (e.g. Wizcoderr/Qwen3-14B-Flutter-Fused)
# Create a free read token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. Market News & Financial Data
# ------------------------------------------------------------------------------
# Free Alpha Vantage API key for supplemental global news / macro indicators
ALPHA_VANTAGE_API_KEY=CZ7Q82UJ6PFXFJ3P

# Brandfetch API Key for equity brand logos
BRANDFETCH_API_KEY=1ideC6LZ3j2ja1ttkzl

# ------------------------------------------------------------------------------
# 4. Database & Storage
# ------------------------------------------------------------------------------
# Default: Local SQLite database with aiosqlite asynchronous driver
DATABASE_URL=sqlite+aiosqlite:///./tradevision.db

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=tradevision_ai_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. Server Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=False
